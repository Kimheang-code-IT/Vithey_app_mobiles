# Live API against local DEMO stack (gateway :8080). Mocks are OFF by default.
APP_ENV=dev

# Android emulator -> host. Physical device: use your PC LAN IP.
API_BASE_URL=http://10.0.2.2:8080/api/v1
WS_BASE_URL=ws://10.0.2.2:8080/ws

API_CONNECT_TIMEOUT_SECONDS=15
API_RECEIVE_TIMEOUT_SECONDS=60

# Opt-in mocks only (unset or false = live API)
USE_MOCK_AUTH=false
USE_MOCK_API=false
USE_MOCK_CHAT=false
USE_MOCK_NOTIFICATIONS=false
USE_MOCK_SEARCH=false
USE_MOCK_AI=false
USE_MOCK_MAP=false

USE_AI_CV=true
USE_AI_FEED=true
USE_AI_SKILLS=true
USE_AI_JOB_MATCH=true

# Turn on only when testing Splash -> Auth funnel
FORCE_DEV_FUNNEL=false
FORCE_SHOW_ONBOARDING=false
FORCE_SHOW_STARTUP=false

ENABLE_GOOGLE_AUTH=false
FCM_ENABLED=false
FCM_DEBUG_TOKEN=

# Google Sign-In Web OAuth client ID (public identifier; NOT a secret).
# Must match backend GOOGLE_WEB_CLIENT_ID. Value ends with
# .apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=

# Optional UI-only mocks (set any to true):
# USE_MOCK_API=true
# USE_MOCK_AUTH=true
# USE_MOCK_AI=true
# USE_MOCK_CHAT=true
# USE_MOCK_MAP=true

# Google Maps (Android): android/local.properties GOOGLE_MAPS_API_KEY=...
# Google Maps (iOS): ios/Flutter/Secrets.xcconfig
