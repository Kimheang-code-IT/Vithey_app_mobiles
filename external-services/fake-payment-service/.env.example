# Fake payment gateway - demo env. Copy to .env for local runs.
# NEVER commit a real key; this service must never hold production credentials.

FAKE_PAYMENT_API_KEY=change-me

# Comma-separated ISO currency codes this demo provider accepts.
FAKE_PAYMENT_SUPPORTED_CURRENCIES=USD,KHR

# Per-currency decimal precision used when normalizing amounts.
FAKE_PAYMENT_CURRENCY_DECIMALS=USD:2,KHR:2

# Deterministic TIMEOUT simulation delay (seconds). Keep tiny for tests.
FAKE_PAYMENT_TIMEOUT_DELAY_SECONDS=0.01

# Optional: auto-complete a PROCESSING payment after N seconds (0 = never).
FAKE_PAYMENT_PROCESSING_SECONDS=0

FAKE_PAYMENT_LOG_LEVEL=INFO
