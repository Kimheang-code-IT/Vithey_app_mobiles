# --- LLM (OpenAI-compatible) -------------------------------------------------
# DeepSeek direct:
#   DEEPSEEK_API_KEY=...
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_MODEL=deepseek-v4-flash
#
# OpenRouter + GLM 5.3 Flash (demo):
#   DEEPSEEK_API_KEY=sk-or-v1-...
#   DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
#   DEEPSEEK_MODEL=z-ai/glm-5.3-flash

DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=z-ai/glm-5.3-flash

# --- Model behaviour ----------------------------------------------------------
# TEMPERATURE=0.2
# MAX_TOKENS=3000
# TIMEOUT_SECONDS=30

# --- Reliability -----------------------------------------------------------------
# MAX_RETRIES=2
# RETRY_BACKOFF_SECONDS=1.0

# --- Cost protection ----------------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_CALLS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Input guards --------------------------------------------------------------------
# MAX_POSTS_PER_BUILD=100
# MAX_CONTENT_CHARS=6000

# --- Cache ------------------------------------------------------------------------------
# CACHE_ENABLED=true
# CACHE_MAX_SIZE=512

# --- Logging --------------------------------------------------------------------------------
# LOG_LEVEL=INFO

# --- HTTP API (`python main.py serve`) --------------------------------------------------------
# API_RATE_LIMIT_PER_MINUTE=30
# API_MAX_BODY_BYTES=524288
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Flutter /api/v1/ai/** (Compose sets these for the container) -----------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:15432/ai_db
# VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev
# USER_PROFILE_BASE_URL=http://localhost:8082
# CONTENT_BASE_URL=http://localhost:8084
# AI_CHAT_MODE=stub
# AI_CV_MAX_POSTS=20
