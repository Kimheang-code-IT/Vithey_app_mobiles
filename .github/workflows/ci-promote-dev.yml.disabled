# Full-stack CI:
# 1. Backend + Flutter tests
# 2. Build & push Docker images to GHCR (on push only)
# 3. Update `dev` branch when all tests pass
#
# Images: ghcr.io/<owner>/vithey-<service>:latest and :sha-<commit>

name: CI — Test, Build Images & Promote to dev

on:
  push:
    branches: [kimheang, main]
  pull_request:
    branches: [kimheang, main, dev]
  workflow_dispatch:

concurrency:
  group: ci-promote-dev-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write
  packages: write

jobs:
  backend-test:
    name: Backend tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven

      - name: Run all backend module tests
        run: mvn -B -f backend/pom.xml test

      - name: Upload backend test reports
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: backend-test-reports
          path: backend/**/target/surefire-reports/

  flutter-test:
    name: Flutter analyze & test
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: vithey_app
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          flutter-version: '3.16.9'
          cache: true

      - name: Prepare env file for assets
        run: cp .env.example .env

      - run: flutter pub get
      - run: flutter analyze --no-fatal-infos
      - run: flutter test

  ai-core-test:
    name: ai-core pytest (external-services)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: external-services/ai-core
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip

      - name: Install ai-core (dev extras)
        run: pip install -e ".[dev]"

      - name: Run ai-core tests
        run: pytest -q

  docker-build-push:
    name: Build & push ${{ matrix.service }}
    runs-on: ubuntu-latest
    needs: [backend-test, flutter-test]
    if: github.event_name == 'push'
    strategy:
      fail-fast: false
      matrix:
        include:
          - service: eureka-server
            dockerfile: infrastructure/eureka-server/Dockerfile
            port: 8761
            context: backend
          - service: config-server
            dockerfile: infrastructure/config-server/Dockerfile
            port: 8888
            context: backend
          - service: api-gateway
            dockerfile: services/api-gateway/Dockerfile
            port: 8080
            context: backend
          - service: auth-service
            dockerfile: services/auth-service/Dockerfile
            port: 8081
            context: backend
          - service: user-profile-service
            dockerfile: services/user-profile-service/Dockerfile
            port: 8082
            context: backend
          - service: file-service
            dockerfile: services/file-service/Dockerfile
            port: 8083
            context: backend
          - service: content-service
            dockerfile: services/content-service/Dockerfile
            port: 8084
            context: backend
          - service: career-service
            dockerfile: services/career-service/Dockerfile
            port: 8085
            context: backend
          - service: finance-service
            dockerfile: services/finance-service/Dockerfile
            port: 8086
            context: backend
          - service: chat-service
            dockerfile: services/chat-service/Dockerfile
            port: 8087
            context: backend
          - service: notification-service
            dockerfile: services/notification-service/Dockerfile
            port: 8088
            context: backend
          - service: ai-core
            dockerfile: Dockerfile
            port: 8100
            context: external-services/ai-core
          - service: map-service
            dockerfile: services/map-service/Dockerfile
            port: 8090
            context: backend
    steps:
      - uses: actions/checkout@v4

      - name: Set lowercase GHCR owner
        id: vars
        run: echo "owner=$(echo '${{ github.repository_owner }}' | tr '[:upper:]' '[:lower:]')" >> $GITHUB_OUTPUT

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ghcr.io/${{ steps.vars.outputs.owner }}/vithey-${{ matrix.service }}
          tags: |
            type=raw,value=latest
            type=sha,prefix=sha-,format=short

      - name: Build and push image
        uses: docker/build-push-action@v5
        with:
          context: ${{ matrix.context }}
          file: ${{ matrix.context }}/${{ matrix.dockerfile }}
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: SERVICE_PORT=${{ matrix.port }}
          cache-from: type=gha,scope=vithey-${{ matrix.service }}
          cache-to: type=gha,mode=max,scope=vithey-${{ matrix.service }}

  docker-summary:
    name: Docker publish summary
    runs-on: ubuntu-latest
    needs: docker-build-push
    if: github.event_name == 'push'
    steps:
      - name: Write image list
        run: |
          OWNER=$(echo '${{ github.repository_owner }}' | tr '[:upper:]' '[:lower:]')
          SHA=$(echo '${{ github.sha }}' | cut -c1-7)
          {
            echo "## Published Docker images"
            echo ""
            echo "Registry: \`ghcr.io/${OWNER}\`"
            echo "Tags: \`latest\`, \`sha-${SHA}\`"
            echo ""
            for svc in eureka-server config-server api-gateway auth-service user-profile-service file-service content-service career-service finance-service chat-service notification-service ai-core map-service; do
              echo "- \`ghcr.io/${OWNER}/vithey-${svc}:latest\`"
            done
          } >> "$GITHUB_STEP_SUMMARY"

  promote-to-dev:
    name: Promote passing commit to dev
    runs-on: ubuntu-latest
    needs: [backend-test, flutter-test, ai-core-test]
    if: >-
      github.event_name == 'push' &&
      github.ref != 'refs/heads/dev' &&
      (github.ref == 'refs/heads/kimheang' || github.ref == 'refs/heads/main')
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Push current commit to dev branch
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git push origin "${GITHUB_SHA}:refs/heads/dev"
        env:
          GITHUB_SHA: ${{ github.sha }}
