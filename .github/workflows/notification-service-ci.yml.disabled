name: notification-service CI

on:
  push:
    branches: [main, Prompt, dev, kimheang]
    paths:
      - 'backend/pom.xml'
      - 'backend/infrastructure/config-repo/notification-service.yml'
      - 'backend/infrastructure/config-server/**'
      - 'backend/infrastructure/eureka-server/**'
      - 'backend/services/notification-service/**'
      - 'backend/services/api-gateway/**'
      - '.github/workflows/notification-service-ci.yml'
  pull_request:
    branches: [main, Prompt, dev, kimheang]
    paths:
      - 'backend/pom.xml'
      - 'backend/infrastructure/config-repo/notification-service.yml'
      - 'backend/infrastructure/config-server/**'
      - 'backend/infrastructure/eureka-server/**'
      - 'backend/services/notification-service/**'
      - 'backend/services/api-gateway/**'
      - '.github/workflows/notification-service-ci.yml'

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven
      - name: Run notification-service tests
        run: mvn -B -f backend/pom.xml -pl services/notification-service -am test
      - name: Upload test reports
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: notification-service-test-reports
          path: backend/services/notification-service/target/surefire-reports/

  docker-build:
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - name: Build notification-service image
        run: docker build -f backend/services/notification-service/Dockerfile --build-arg SERVICE_PORT=8088 -t vithey-notification-service:ci backend

  compose-validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate notification-service compose
        run: docker compose -f backend/services/notification-service/docker-compose.yml config
