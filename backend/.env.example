# Vithey backend — Compose environment (copy to backend/.env)
#
# Docker Compose auto-loads this file, so every value here is a tunable knob:
# scale up later by editing numbers only — no compose edits required.
#
# Quick start:
#   copy .env.example .env
#
# Profiles (optional services):
#   COMPOSE_PROFILES=            # lean core (default)
#   COMPOSE_PROFILES=map         # also start map-service (needs GOOGLE_PLACES_API_KEY)
#   COMPOSE_PROFILES=monitoring  # started separately from ../monitoring
COMPOSE_PROFILES=

# ── Dev secrets (override in real environments; never used by production) ────
VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev

# ── Java services (all domain services + platform) ───────────────────────────
# These flags override the image default (Dockerfile sets
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0), so -Xmx here is authoritative.
# Lower for the 3-user phase; raise (e.g. -Xmx512m) when scaling up.
# Even leaner (slower JIT, faster startup): append -XX:TieredStopAtLevel=1
SERVICE_JAVA_OPTS=-XX:+UseSerialGC -Xms96m -Xmx192m -XX:MaxMetaspaceSize=96m
SERVICE_MEM_LIMIT=320m

# Platform (eureka-server, config-server) — smaller than app services.
PLATFORM_JAVA_OPTS=-XX:+UseSerialGC -Xms64m -Xmx160m -XX:MaxMetaspaceSize=96m
PLATFORM_MEM_LIMIT=256m

# API gateway — needs a bit more headroom.
GATEWAY_JAVA_OPTS=-XX:+UseSerialGC -Xms96m -Xmx256m -XX:MaxMetaspaceSize=128m
GATEWAY_MEM_LIMIT=384m

# ── Datastores / messaging ───────────────────────────────────────────────────
PG_MEM_LIMIT=384m
PG_MAX_CONNECTIONS=40
PG_SHARED_BUFFERS=96MB
PG_WORK_MEM=4MB
PG_EFFECTIVE_CACHE_SIZE=256MB

REDIS_MEM_LIMIT=96m
REDIS_MAXMEMORY=64mb

RABBITMQ_MEM_LIMIT=192m
MINIO_MEM_LIMIT=128m

# ── Connection pools (consumed by config-repo/application.yml) ───────────────
DB_POOL_MAX=5
DB_POOL_MIN=1
RABBIT_CONCURRENCY=1
RABBIT_MAX_CONCURRENCY=2

# ── ai_core (Python) ─────────────────────────────────────────────────────────
AI_CORE_MEM_LIMIT=256m
AI_CORE_WORKERS=1

# ── Optional: map-service (only used with COMPOSE_PROFILES=map) ──────────────
# GOOGLE_PLACES_API_KEY=

# fake-payment-service (DEV/DEMO/UAT ONLY — no real money)
# Container always listens on 8090; the host port defaults to 8110 so it does
# not clash with map-service (host 8090).
FAKE_PAYMENT_HOST_PORT=8110
FAKE_PAYMENT_API_KEY=change-me
FAKE_PAYMENT_MEM_LIMIT=192m

# ── Google Sign-In (auth-service) ────────────────────────────────────────────
# Web OAuth client ID; Google ID tokens must have this audience. No client
# secret is stored server-side (ID tokens are verified, not exchanged).
GOOGLE_WEB_CLIENT_ID=
