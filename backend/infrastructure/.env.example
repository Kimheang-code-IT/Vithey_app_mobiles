POSTGRES_DB=vithey
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

EUREKA_URL=http://eureka-server:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_REPO_LOCATION=file:/app/config-repo

# Required in production (SPRING_PROFILES_ACTIVE=prod)
VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev-only

# Gateway rate limiting (optional overrides)
VITHEY_GATEWAY_RATE_LIMIT_REPLENISH=100
VITHEY_GATEWAY_RATE_LIMIT_BURST=100
VITHEY_GATEWAY_RATE_LIMIT_TOKENS=1
VITHEY_CORS_ALLOWED_ORIGINS=*
