SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=docker
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_CLIENT_ENABLED=true
EUREKA_URL=http://eureka-server:8761/eureka/

AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev
VITHEY_ACCESS_TOKEN_TTL=15m
VITHEY_REFRESH_TOKEN_TTL=7d
VITHEY_EVENTS_EXCHANGE=vithey.events

# Google Sign-In: Web OAuth client ID (the ID token audience). No client secret
# is needed because the backend only verifies ID tokens. Leave blank to disable.
GOOGLE_WEB_CLIENT_ID=
# GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

# log (default, tokens printed in auth-service logs) | smtp
VITHEY_MAIL_MODE=log
VITHEY_MAIL_FROM=noreply@vithey.local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
