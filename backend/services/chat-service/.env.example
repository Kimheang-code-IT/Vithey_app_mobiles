SERVER_PORT=8087
SPRING_PROFILES_ACTIVE=docker
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_CLIENT_ENABLED=true
EUREKA_URL=http://eureka-server:8761/eureka/

CHAT_DB_URL=jdbc:postgresql://postgres:5432/chat_db
CHAT_DB_USERNAME=postgres
CHAT_DB_PASSWORD=postgres

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

REDIS_HOST=redis
REDIS_PORT=6379

VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev
VITHEY_EVENTS_EXCHANGE=vithey.events
