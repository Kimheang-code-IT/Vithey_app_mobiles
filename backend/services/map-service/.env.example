SERVER_PORT=8090
SPRING_PROFILES_ACTIVE=docker
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_CLIENT_ENABLED=true
EUREKA_URL=http://eureka-server:8761/eureka/

MAP_DB_URL=jdbc:postgresql://map-postgres:5432/map_db
MAP_DB_USERNAME=postgres
MAP_DB_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379

VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev

# Server-restricted Google Places API (New) key. NEVER ship a client/Android key here.
GOOGLE_PLACES_API_KEY=

# Optional template for client-visible photo URLs (photo proxy deferred to v1.1)
GOOGLE_PLACES_PHOTO_URL_TEMPLATE=
